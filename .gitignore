# CompareM2 runtime
.snakemake
results_comparem2
output_comparem2/
singularity_images
databases
trash

# Under tests/: the input zips, the README and tests/unit are all tracked.
# What must not be is anything unpacked from a zip or produced by a run — the
# blanket `tests` rule that used to sit here caught nothing else and silently
# kept the v3 unit suite out of the repository.
tests/**/*.fna
tests/**/*.fa
tests/**/*.fasta
tests/**/*.gff3
tests/**/*.faa

# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
*.egg

# Build artefacts from `pip install .` / `python -m build`. The package is
# built from pyproject.toml by bioconda, never from a tree here.
build/
dist/
# `uv run` writes this when it resolves pyproject.toml for a throwaway test
# environment. The project's lock is pixi.lock.
uv.lock

# R
.Rproj.user
.Rhistory
.RData

# pixi environments
.pixi/*
!.pixi/config.toml

# OS
.DS_Store
._*

# Editors / IDEs
.vscode/
.idea/

# Environments
.env
.venv

# mkdocs
/site

# Reference papers for the tool set. The PDFs are local working copies — 50 MB
# in history forever, and one of them (MAFFT, CC BY-NC 3.0) could not be
# redistributed anyway. What is tracked is the derived reading: SUMMARIES.md,
# tools.bib and the README that says where each PDF came from, so they can be
# fetched again.
papers/*.pdf
papers/.pytest_cache/

# Misc
*.log
