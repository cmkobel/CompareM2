# CompareM2 runtime
.snakemake
results_comparem2
output_comparem2/
singularity_images
databases
trash

# Under tests/: the input zips, the README and tests/unit are all tracked.
# What must not be is anything unpacked from a zip or produced by a run — the
# blanket `tests` rule that used to sit here caught nothing else and silently
# kept the v3 unit suite out of the repository.
tests/**/*.fna
tests/**/*.fa
tests/**/*.fasta
tests/**/*.gff3
tests/**/*.faa

# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
*.egg

# R
.Rproj.user
.Rhistory
.RData

# pixi environments
.pixi/*
!.pixi/config.toml

# OS
.DS_Store
._*

# Editors / IDEs
.vscode/
.idea/

# Environments
.env
.venv

# mkdocs
/site

# Reference papers for the tool set — local working copies, not tracked.
papers/

# Misc
*.log
